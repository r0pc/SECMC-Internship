<Project Sdk="Microsoft.NET.Sdk">

  <!-- Integration tests: collector -> database -> API data flow (SOW 11.1). -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DataIntelligence.Api\DataIntelligence.Api.csproj" />
    <ProjectReference Include="..\..\src\DataIntelligence.Infrastructure\DataIntelligence.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Same reference dataset as the unit tests; see the note in that project file. -->
  <ItemGroup>
    <Compile Include="..\Shared\PublishedData.cs" Link="Collection\PublishedData.cs" />
    <Content Include="..\..\..\docs\example_data\*.csv"
             Link="ExampleData\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
