<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests: backend services, data validation, NL-to-SQL translation logic (SOW 11.1). -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DataIntelligence.Core\DataIntelligence.Core.csproj" />
    <ProjectReference Include="..\..\src\DataIntelligence.Infrastructure\DataIntelligence.Infrastructure.csproj" />
    <!-- For the command-line parsing rules, which are mostly refusals worth testing. -->
    <ProjectReference Include="..\..\src\DataIntelligence.Worker\DataIntelligence.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The published extracts are the reference dataset for the accuracy tests. Copied to the
       output so the tests do not depend on the working directory, and linked from docs/ so there
       is one copy in the repository rather than a stale duplicate under tests/. -->
  <ItemGroup>
    <Compile Include="..\Shared\PublishedData.cs" Link="Collection\PublishedData.cs" />
    <Content Include="..\..\..\docs\example_data\*.csv"
             Link="ExampleData\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
