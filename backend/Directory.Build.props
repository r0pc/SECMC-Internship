<Project>

  <!-- Shared settings for every project in the solution. Individual .csproj files
       should not redeclare TargetFramework / Nullable / ImplicitUsings. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591: missing XML comment on a public member. Enable once the API surface is real. -->
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

</Project>
